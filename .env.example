# Delivery Ledger - environment variables
#
# Placeholders only. Never commit real values to this file; see CLAUDE.md.
# Real values live in Vercel (`vercel env ls`) and, for local work, in
# .env.local, which is gitignored.

# --- Supabase, client-side (safe to expose; shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# --- Supabase, server-side ONLY (never NEXT_PUBLIC_, never in the browser bundle) ---
# Bypasses row-level security entirely. Set it in Vercel and in .env.local; nowhere else.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- pgcrypto key name (the key itself lives in Supabase Vault, not here) ---
# Per spec 7a: encryption keys are held in Vault and referenced by name.
APP_ENCRYPTION_KEY_NAME=delivery_ledger_column_key

# ---------------------------------------------------------------------------
# NOT read by the application. Read by the mode-2 session-capture hook
# (scripts/claude-session-capture.sh) from Erik's own shell environment.
# Listed here because this file is where this project documents which variables
# exist. Do NOT set these in Vercel; they belong in the shell profile that
# Claude Code inherits on Erik's machine.
# ---------------------------------------------------------------------------

# Where the hook posts. Must be https:// — the hook passes `--proto '=https'`
# to curl and the token will not cross a plaintext connection.
DELIVERY_LEDGER_URL=https://<the deployment>

# An agent token with the ingest:write capability. Issued in the app, shown
# once, stored only as a hash. Placeholder only, as with every value here.
DELIVERY_LEDGER_INGEST_TOKEN=dl_<token-id>_<secret>

# Optional, all three. Absent means a less detailed record, never a rejected
# one. `DELIVERY_LEDGER_ENGAGEMENT` is currently the ONLY way an ingested
# session resolves to a named engagement — see the queued question about
# spec 7a refusing agent tokens `engagement.repo_path`.
DELIVERY_LEDGER_ENGAGEMENT=<engagement-slug>
DELIVERY_LEDGER_STACK=<stack-name>
DELIVERY_LEDGER_SUMMARY=<one-line summary the session writes>
