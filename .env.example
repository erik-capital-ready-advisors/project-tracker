# Delivery Ledger - environment variables
#
# Placeholders only. Never commit real values to this file; see CLAUDE.md.
# Real values live in Vercel (`vercel env ls`) and, for local work, in
# .env.local, which is gitignored.

# --- Supabase, client-side (safe to expose; shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# --- Supabase, server-side ONLY (never NEXT_PUBLIC_, never in the browser bundle) ---
# Bypasses row-level security entirely. Set it in Vercel and in .env.local; nowhere else.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- pgcrypto key name (the key itself lives in Supabase Vault, not here) ---
# Per spec 7a: encryption keys are held in Vault and referenced by name.
APP_ENCRYPTION_KEY_NAME=delivery_ledger_column_key
